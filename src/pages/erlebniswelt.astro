---
import Base from '../layouts/Base.astro';
import PageHead from '../components/ui/PageHead.astro';
import ActCards from '../components/ui/ActCards.astro';
import MoreLinks from '../components/ui/MoreLinks.astro';
import Photo from '../components/ui/Photo.astro';
import type { ActItem } from '../components/ui/ActCards.astro';

const outdoor: ActItem[] = [
  { t: 'Schach', icon: 'schach' },
  { t: 'Boule', icon: 'boule' },
  {
    t: 'Streichelzoo',
    soon: true,
    icon: 'zoo',
  },
];
const indoor: ActItem[] = [
  { t: 'Souvenirshop', icon: 'shop' },
  { t: 'Billard*', icon: 'billard' },
  {
    t: 'Darts*',
    icon: 'darts',
  },
  { t: 'Tischkicker*', icon: 'kicker' },
];
---

<Base
  title="Erlebniswelt"
  description="Boule, Schach, Billard, Darts und Tischkicker direkt am Haus: die Erlebniswelt der Gaststätte Dat swarte Peerd in Bongsiel."
>
  <PageHead
    kicker="Erlebniswelt"
    title="Spielen, staunen,"
    hand="Zeit haben"
    lead="Draußen im Garten und drinnen im Haus gibt es einiges zu entdecken – für Kinder, Familien und alle, die nach dem Essen noch bleiben wollen."
    photo="garten-boule"
    photoAlt="Garten mit Bouleplatz, Birken und Gartenhaus"
  />
  <div class="bs-erl bs-wrap">
    <section aria-labelledby="h-out">
      <h2 id="h-out" class="bs-h2 bs-lines">
        <span class="bs-line">
          <span>Outdoor</span>
        </span>
        <span class="bs-line" style="--l:1">
          <span class="bs-hand">im Garten</span>
        </span>
      </h2>
      <ActCards items={outdoor} />
    </section>
    <section aria-labelledby="h-in">
      <h2 id="h-in" class="bs-h2 bs-lines">
        <span class="bs-line">
          <span>Indoor</span>
        </span>
        <span class="bs-line" style="--l:1">
          <span class="bs-hand">im Haus</span>
        </span>
      </h2>
      <ActCards items={indoor} />
      <p class="bs-erl__fee" data-reveal>
        * gegen Gebühr
      </p>
    </section>
    <figure class="bs-photo bs-erl__ph" data-wipe style="--wipe: var(--bs-linen)">
      <Photo name="teich-lounge" alt="Sitzgruppe am Fischteich mit Sandstrand" sizes="(max-width: 900px) 92vw, 600px" />
    </figure>
  </div>
  <MoreLinks current="/erlebniswelt/" />
</Base>

<style is:global>
  .bs-erl {
    display: grid;
    gap: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(72px, 9vw, 120px);
  }
  .bs-erl .bs-h2 {
    margin-bottom: 28px;
  }
  .bs-erl__fee {
    margin: 14px 4px 0;
    font-size: 0.9rem;
    color: var(--bs-grey);
  }
  .bs-erl__ph {
    max-width: 520px;
    justify-self: center;
    border-radius: var(--bs-r-lg);
    overflow: hidden;
  }
</style>
