---
import Base from '../layouts/Base.astro';
import PageHead from '../components/ui/PageHead.astro';
import Photo from '../components/ui/Photo.astro';
import EnquiryForm from '../components/ui/EnquiryForm.astro';
import { PortableText } from 'emdash/ui';
import { getPageText, hasPT } from '../lib/cms';

const page = await getPageText('eventlocation');
const rooms = [
  {
    photo: 'saal',
    alt: 'Der Saal mit langen Tischen und Blick in die Marsch',
    t: 'Saal',
    d: 'Bis 120 Personen · 160 m²',
  },
  {
    photo: 'kaminecke',
    alt: 'Gemütliche Ecke mit Lederbank und Delfter Kacheln',
    t: 'Kaminzimmer',
    d: 'Für kleinere Runden',
  },
  { photo: 'bar', alt: 'Bar mit Gläsern und Zapfanlage', t: 'Partyfass', d: 'Bis 12 Personen' },
] as const;
const layouts = [
  { t: 'Reihe', rows: 'M10 14h80M10 30h80M10 46h80M10 62h80' },
  { t: 'Bankett', rows: 'M14 12h28v56H14zM58 12h28v56H58z' },
  {
    t: 'Gala',
    rows: 'M30 24m-12 0a12 12 0 1 0 24 0a12 12 0 1 0 -24 0M70 24m-12 0a12 12 0 1 0 24 0a12 12 0 1 0 -24 0M30 58m-12 0a12 12 0 1 0 24 0a12 12 0 1 0 -24 0M70 58m-12 0a12 12 0 1 0 24 0a12 12 0 1 0 -24 0',
  },
  { t: 'Parlamentarisch', rows: 'M10 14h80v8H10zM10 36h80v8H10zM10 58h80v8H10z' },
];
---

<Base
  title="Feiern & Eventlocation"
  description="Saal für bis zu 120 Personen, Kaminzimmer und Partyfass: Feiern im Dat swarte Peerd in Bongsiel."
>
  <PageHead
    kicker="Feiern in Bongsiel"
    title="Platz für"
    hand="eure Feier"
    lead={
      page?.intro ||
      'Ein großer Veranstaltungsraum von 160 m² bietet für nahezu jeden Wunsch die perfekten Räumlichkeiten.'
    }
    photo="saal-tafel"
    photoAlt="Festlich gedeckte lange Tafel im Saal"
  />

  <section class="bs-el bs-wrap">
    <div class="bs-el__facts">
      <div data-reveal>
        <b>
          <span data-count="120">120</span>
        </b>
        <span>Personen im Saal</span>
      </div>
      <div data-reveal style="--i:1">
        <b>
          <span data-count="160">160</span> m²
        </b>
        <span>Veranstaltungsraum</span>
      </div>
      <div data-reveal style="--i:2">
        <b>
          <span data-count="12">12</span>
        </b>
        <span>Personen im Partyfass</span>
      </div>
    </div>
    {page && hasPT(page.body) && (
      <div class="bs-prose bs-el__body" data-reveal>
        <PortableText value={page.body as never} />
      </div>
    )}
    <div class="bs-el__rooms">
      {rooms.map((r, i) => (
        <article class="bs-el__room" data-reveal style={`--i:${i}`}>
          <figure class="bs-photo bs-el__ph">
            <Photo name={r.photo} alt={r.alt} sizes="(max-width: 900px) 92vw, 400px" />
          </figure>
          <h2 class="bs-el__t">{r.t}</h2>
          <p class="bs-el__d">{r.d}</p>
        </article>
      ))}
    </div>

    <div class="bs-el__lay">
      <h2 class="bs-h2" data-reveal>
        Bestuhlung im Saal
      </h2>
      <ul>
        {layouts.map((l, i) => (
          <li data-reveal style={`--i:${i}`}>
            <svg viewBox="0 0 100 80" aria-hidden="true">
              <path d={l.rows} pathLength="1" />
            </svg>
            <b>{l.t}</b>
            <span>bis 120 Personen</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="bs-el__ask" id="anfrage">
      <div>
        <p class="bs-kicker" data-reveal>
          Anfrage
        </p>
        <h2 class="bs-h2 bs-lines">
          <span class="bs-line">
            <span>Erzählt uns</span>
          </span>
          <span class="bs-line" style="--l:1">
            <span class="bs-hand">von eurer Feier</span>
          </span>
        </h2>
        <p class="bs-lead" data-reveal style="--i:2">
          Unser Küchenchef steht euch gerne mit kreativen Vorschlägen für eure nächste Veranstaltung zur Verfügung.
        </p>
        <a class="bs-link" href="/speisekarten/buffet-vorschlaege/" data-reveal style="--i:3">
          Buffet-Vorschläge ansehen →
        </a>
      </div>
      <div data-reveal style="--i:2">
        <EnquiryForm
          kind="feier"
          topics={['Geburtstag', 'Hochzeit', 'Firmenfeier', 'Weihnachtsfeier', 'Familienfeier', 'Sonstiges']}
        />
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .bs-el {
    display: grid;
    gap: clamp(56px, 8vw, 110px);
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  .bs-el__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .bs-el__facts div {
    display: grid;
    gap: 4px;
    padding: 28px;
    border-radius: var(--bs-r-lg);
    background: var(--bs-cream);
  }
  .bs-el__facts b {
    font-family: var(--bs-head);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem);
    color: var(--bs-delft);
    line-height: 1;
  }
  .bs-el__facts span:last-child {
    color: var(--bs-grey);
  }
  .bs-el__body {
    max-width: 62ch;
    font-size: 1.08rem;
    color: var(--bs-grey);
  }
  .bs-el__rooms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .bs-el__ph {
    aspect-ratio: 4 / 3;
    margin-bottom: 18px;
  }
  .bs-el__t {
    font-size: 1.1rem;
  }
  .bs-el__d {
    color: var(--bs-grey);
  }
  .bs-el__lay ul {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .bs-el__lay li {
    display: grid;
    gap: 4px;
    padding: 24px;
    border: 1px solid var(--bs-line);
    border-radius: var(--bs-r-lg);
    background: #fff;
  }
  .bs-el__lay svg {
    width: 100%;
    max-width: 120px;
    margin-bottom: 14px;
    fill: none;
    stroke: var(--bs-delft);
    stroke-width: 1.6;
  }
  .bs-el__lay path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1600ms var(--bs-ease-io) 300ms;
  }
  .js .bs-el__lay li[data-reveal]:not(.is-in) path {
    stroke-dashoffset: 1;
  }
  .bs-el__lay span {
    font-size: 0.88rem;
    color: var(--bs-grey);
  }
  .bs-el__ask {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    padding: clamp(28px, 5vw, 64px);
    border-radius: var(--bs-r-lg);
    background: var(--bs-cream);
  }
  .bs-el__ask .bs-lead {
    margin: 18px 0;
  }
  @media (max-width: 900px) {
    .bs-el__rooms,
    .bs-el__ask {
      grid-template-columns: minmax(0, 1fr);
    }
    .bs-el__lay ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .bs-el__facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
