---
import Base from '../layouts/Base.astro';
import PageHead from '../components/ui/PageHead.astro';
import Gallery from '../components/ui/Gallery.astro';
import Photo from '../components/ui/Photo.astro';
import { PortableText } from 'emdash/ui';
import { getPageText, getSite, hasPT } from '../lib/cms';
import { hoursSummary } from '../lib/booking';

const page = await getPageText('gaststaette');
const site = await getSite();
const hours = hoursSummary(site.week);
---

<Base
  title="Gaststätte"
  description="Traditionsgaststätte Dat swarte Peerd in Bongsiel: über 120 Jahre Gastlichkeit am alten Fähranleger zu den Halligen."
>
  <PageHead
    kicker="Gaststätte"
    title="Dat swarte"
    hand="Peerd"
    lead={page?.intro || 'Kachelwand, Stammtisch, Kerzenlicht – und eine Geschichte, die über 120 Jahre zurückreicht.'}
    photo="gaststube-panorama"
    photoSizes="(max-width: 700px) 220vw, (max-width: 1340px) 94vw, 1280px"
    photoAlt="Die Gaststube mit Delfter Kachelwand, Bilderwand und Stammtisch"
  />
  <section class="bs-gs bs-wrap">
    <div class="bs-gs__text">
      <h2 class="bs-h2" data-reveal>
        {page?.title || 'Traditionsgaststätte'}
      </h2>
      {page && hasPT(page.body) && (
        <div class="bs-prose bs-gs__body" data-reveal style="--i:1">
          <PortableText value={page.body as never} />
        </div>
      )}
      <div class="bs-gs__cta" data-reveal style="--i:2">
        <a class="bs-btn bs-btn--ember" href="/reservierung/">
          Tisch reservieren
        </a>
        <a class="bs-btn bs-btn--ghost" href="/speisen/">
          Speisekarte
        </a>
      </div>
    </div>
    <aside class="bs-gs__side" data-reveal style="--i:2">
      <figure class="bs-photo bs-gs__sign">
        <Photo
          name="schild"
          alt="Ovales Schild „Gaststätte Bongsiel – Dat swarte Peerd“ mit Pferdekopf an der Backsteinwand"
          sizes="360px"
        />
      </figure>
      <h3 class="bs-gs__h">Öffnungszeiten</h3>
      <dl class="bs-gs__hours">
        {hours.map((h) => (
          <div>
            <dt>{h.days}</dt>
            <dd>{h.hours}</dd>
          </div>
        ))}
      </dl>
      <p class="bs-gs__small">Küche bis 20:30 Uhr, sonntags mittags bis 13:30 Uhr.</p>
    </aside>
  </section>
  <section class="bs-gs__gal" aria-label="Einblicke">
    <Gallery
      items={[
        { name: 'gaststube-abend', alt: 'Gaststube am Abend mit blauer Vertäfelung' },
        { name: 'bar', alt: 'Bar mit Gläsern und Kupfer-Kaffeekanne vor blau-weißen Kacheln' },
        { name: 'kaminecke', alt: 'Eckbank mit Lederlehnen und Kerze' },
        { name: 'gaststube-tag', alt: 'Gaststube bei Tageslicht mit langen Tischen' },
        { name: 'tisch-blume', alt: 'Gedeckter Tisch mit Blume' },
        { name: 'eingang-nacht', alt: 'Eingang am Abend mit Tannengirlande' },
      ]}
    />
  </section>
</Base>

<style is:global>
  .bs-gs {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
    padding-bottom: clamp(60px, 8vw, 110px);
  }
  .bs-gs__text {
    display: grid;
    gap: 24px;
  }
  .bs-gs__text .bs-h2 {
    margin-top: 0;
  }
  .bs-gs__body {
    color: var(--bs-grey);
    font-size: 1.08rem;
  }
  .bs-gs__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .bs-gs__side {
    position: sticky;
    top: calc(var(--bs-header-h) + 24px);
    padding: 28px;
    border-radius: var(--bs-r-lg);
    background: var(--bs-cream);
  }
  .bs-gs__sign {
    aspect-ratio: 4 / 3;
    margin-bottom: 24px;
  }
  .bs-gs__h {
    font-size: 0.95rem;
    margin-bottom: 12px;
  }
  .bs-gs__hours {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .bs-gs__hours div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .bs-gs__hours dt {
    color: var(--bs-grey);
  }
  .bs-gs__hours dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
    white-space: pre-line;
  }
  .bs-gs__small {
    margin-top: 14px;
    font-size: 0.85rem;
    color: var(--bs-grey);
  }
  .bs-gs__gal {
    padding-bottom: clamp(80px, 10vw, 140px);
  }
  @media (max-width: 900px) {
    .bs-gs {
      grid-template-columns: minmax(0, 1fr);
    }
    .bs-gs__side {
      position: static;
    }
  }
</style>
