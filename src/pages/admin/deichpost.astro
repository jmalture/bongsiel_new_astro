---
import Admin from '../../layouts/Admin.astro';
import { loginUrl, staff } from '../../lib/auth';
import { getDb } from '../../lib/db';

if (!staff(Astro.locals)) return Astro.redirect(loginUrl('/admin/deichpost/'));
type Row = { id: number; email: string; name: string; source: string; created_at: string };
const rows = getDb().prepare(`SELECT * FROM subscribers ORDER BY created_at DESC`).all() as unknown as Row[];
const act = (o: object) => JSON.stringify(o);
const src: Record<string, string> = { website: 'Website', reservierung: 'Reservierung', admin: 'Von Hand' };
---

<Admin title="Deichpost">
  <div class="ad-top">
    <div>
      <h1 class="ad-h1">Deichpost</h1>
      <p class="ad-sub">Anmeldungen für den Newsletter. Für den Versand als CSV exportieren.</p>
    </div>
    <div class="ad-row">
      <a class="ad-btn ad-btn--main" href="/api/admin?export=subscribers">
        CSV (Excel)
      </a>
    </div>
  </div>
  <div data-live-list="subs">
    <div class="ad-kpis">
      <div class="ad-card ad-kpi">
        <b>{rows.length}</b>
        <span>Abonnenten</span>
      </div>
      <div class="ad-card ad-kpi">
        <b>{rows.filter((r) => r.source === 'reservierung').length}</b>
        <span>über Reservierung</span>
      </div>
    </div>
    {rows.length === 0 ? (
      <div class="ad-card ad-empty">Noch keine Anmeldungen.</div>
    ) : (
      <div class="ad-card">
        <table class="ad-table">
          <thead>
            <tr>
              <th>E-Mail</th>
              <th>Name</th>
              <th>Quelle</th>
              <th>Seit</th>
              <th />
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>
                  <b>{r.email}</b>
                </td>
                <td>{r.name}</td>
                <td>{src[r.source] ?? r.source}</td>
                <td>{`${r.created_at.slice(8, 10)}.${r.created_at.slice(5, 7)}.${r.created_at.slice(0, 4)}`}</td>
                <td class="ad-right">
                  <button
                    class="ad-btn ad-btn--sm"
                    data-act={act({ action: 'sub.delete', id: r.id })}
                    data-confirm="Löschen?"
                    data-done="Gelöscht"
                  >
                    Abmelden
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
  <details class="ad-card ad-new">
    <summary>+ Abonnent hinzufügen</summary>
    <form class="ad-form" data-act-form="sub.add" data-done="Hinzugefügt">
      <label>
        E-Mail
        <input class="ad-input" name="email" type="email" required maxlength="160" />
      </label>
      <label>
        Name
        <input class="ad-input" name="name" maxlength="80" />
      </label>
      <div class="ad-wide">
        <button class="ad-btn ad-btn--main" type="submit">
          Hinzufügen
        </button>
      </div>
    </form>
  </details>
</Admin>

<style is:global>
  .ad-table {
    width: 100%;
    border-collapse: collapse;
  }
  .ad-table th {
    padding: 12px 16px;
    text-align: left;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ad-grey);
    border-bottom: 1px solid var(--ad-line);
  }
  .ad-table td {
    padding: 10px 16px;
    border-top: 1px solid var(--ad-line);
  }
  .ad-right {
    text-align: right;
  }
  .ad-new {
    margin-top: 18px;
  }
  @media (max-width: 760px) {
    .ad-table th:nth-child(3),
    .ad-table td:nth-child(3),
    .ad-table th:nth-child(4),
    .ad-table td:nth-child(4) {
      display: none;
    }
  }
</style>
