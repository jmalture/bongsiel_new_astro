---
import ActIcon from './ActIcon.astro';
/** A grid of small cards: round dashed icon, title, optional facts line, text and an external link. */
export interface ActItem {
  t: string;
  icon: string; // name in ActIcon.astro
  meta?: string;
  text?: string;
  href?: string;
  label?: string;
  soon?: boolean;
}
interface Props {
  items: ActItem[];
}
const { items } = Astro.props;
---

<ul class="bs-act">
  {items.map((a, i) => (
    <li class:list={['bs-act__card', { 'is-soon': a.soon }]} data-reveal style={`--i:${i % 3}`}>
      <span class="bs-act__ic" aria-hidden="true">
        <ActIcon name={a.icon} />
      </span>
      <h3 class="bs-act__t">{a.t}</h3>
      {a.soon && <span class="bs-act__soon">kommt bald</span>}
      {a.meta && <p class="bs-act__meta">{a.meta}</p>}
      {a.text && <p class="bs-act__text">{a.text}</p>}
      {a.href && (
        <a class="bs-link bs-act__go" href={a.href} target="_blank" rel="noopener">
          {a.label ?? 'Mehr erfahren'} ↗
        </a>
      )}
    </li>
  ))}
</ul>

<style is:global>
  .bs-act {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: 16px;
  }
  .bs-act__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px;
    border-radius: var(--bs-r-lg);
    background: #fff;
    border: 1px solid var(--bs-line);
    transition:
      transform 500ms var(--bs-ease),
      box-shadow 500ms var(--bs-ease);
  }
  @media (hover: hover) {
    .bs-act__card:hover {
      transform: translateY(-5px);
      box-shadow: var(--bs-shadow);
    }
    .bs-act__card:hover .bs-act__ic {
      transform: rotate(-10deg) scale(1.08);
    }
  }
  .bs-act__ic {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    color: var(--bs-sage-d);
    background: color-mix(in srgb, var(--bs-sage) 14%, #fff);
    border: 1.5px dashed color-mix(in srgb, var(--bs-sage) 60%, #fff);
    transition: transform 500ms var(--bs-ease);
  }
  .bs-act__ic svg {
    width: 42px;
    height: 42px;
  }
  .bs-act__t {
    font-family: var(--bs-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1rem;
    line-height: 1.25;
    margin: 6px 0 0;
    text-wrap: balance;
  }
  .bs-act__meta {
    margin: 0;
    padding: 3px 12px;
    border-radius: var(--bs-pill);
    background: var(--bs-cream);
    border: 1px solid var(--bs-line);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .bs-act__text {
    margin: 0;
    color: var(--bs-grey);
    font-size: 0.95rem;
  }
  .bs-act__go {
    margin-top: auto;
    padding-top: 6px;
    font-weight: 600;
  }
  .bs-act__soon {
    padding: 3px 12px;
    border-radius: var(--bs-pill);
    background: rgba(201, 131, 63, 0.16);
    color: var(--bs-warn);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .bs-act__card.is-soon .bs-act__ic {
    border-color: color-mix(in srgb, var(--bs-ember) 60%, #fff);
    color: var(--bs-ember);
    background: color-mix(in srgb, var(--bs-ember) 12%, #fff);
  }
</style>
