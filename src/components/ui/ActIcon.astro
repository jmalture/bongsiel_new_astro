---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name] ?? ''}
/>

<style is:global>
  .ai {
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ai-sway {
      animation: ai-sway 5s ease-in-out infinite alternate;
    }
    .ai-bob {
      animation: ai-bob 3.6s ease-in-out infinite alternate;
    }
    .ai-blink {
      animation: ai-blink 2.6s ease-in-out infinite;
    }
    .ai-walk {
      animation: ai-walk 1.8s ease-in-out infinite alternate;
    }
    .ai-wave {
      animation: ai-wave 3.4s ease-in-out infinite alternate;
    }
    .ai-d2 {
      animation-delay: -1.6s;
    }
    .ai-roll {
      animation: ai-roll 7s linear infinite;
    }
    .ai-roll1 {
      animation: ai-roll 12s linear infinite;
    }
    .ai-rock {
      animation: ai-rock 4s ease-in-out infinite alternate;
    }
    .ai-jump {
      animation: ai-jump 1.6s cubic-bezier(0.3, 0, 0.7, 1) infinite alternate;
    }
    .ai-dart {
      animation: ai-dart 3s ease-in-out infinite;
    }
    .ai-slide {
      animation: ai-slide 2.4s ease-in-out infinite alternate;
    }
    .bs-act__card:hover .ai,
    .bs-act__card:focus-within .ai {
      animation-duration: 1.6s;
    }
  }
  @keyframes ai-sway {
    from {
      transform: rotate(-10deg);
    }
    to {
      transform: rotate(10deg);
    }
  }
  @keyframes ai-bob {
    from {
      transform: translateY(0.6px);
    }
    to {
      transform: translateY(-1px);
    }
  }
  @keyframes ai-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.15;
    }
  }
  @keyframes ai-walk {
    from {
      transform: translateY(0) rotate(-2deg);
    }
    to {
      transform: translateY(-0.8px) rotate(2deg);
    }
  }
  @keyframes ai-wave {
    from {
      transform: translateX(-1.6px);
    }
    to {
      transform: translateX(1.6px);
    }
  }
  @keyframes ai-roll {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes ai-rock {
    from {
      transform: rotate(-3deg);
    }
    to {
      transform: rotate(3deg);
    }
  }
  @keyframes ai-jump {
    from {
      transform: translateY(1.5px);
    }
    to {
      transform: translateY(-2.2px);
    }
  }
  @keyframes ai-dart {
    0%,
    55% {
      transform: translate(0, 0);
    }
    70% {
      transform: translate(-1.6px, 1.6px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
  @keyframes ai-slide {
    from {
      transform: translateX(-1.4px);
    }
    to {
      transform: translateX(1.4px);
    }
  }
</style>
