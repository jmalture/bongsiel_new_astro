# Mein Ziel Bongsiel – Umgebungsvariablen (Vorlage). Kopieren nach .env (lokal) oder in den Hostinger-Einstellungen eintragen.
# Niemals echte Werte einchecken.

# --- Pflicht in Produktion ---------------------------------------------------
# Absoluter Pfad AUSSERHALB der App (ein Hostinger-Build leert den App-Ordner). Datenbank, Uploads, service.db liegen hier.
# Vor dem ersten Build setzen: der Pfad wird beim Build eingebaut. Build und Start müssen denselben Wert haben.
DATA_DIR=/home/USER/site-data/bongsiel
# Öffentliche Adresse der Seite (Vorschau oder Live-Domain), mit https://. Ohne sie schlägt das EmDash-Setup mit SITE_URL_REQUIRED fehl.
EMDASH_SITE_URL=https://vorschau.example.de
# Schlüssel für EmDash: npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# --- E-Mail (ohne SMTP werden Mails nur ins Server-Log geschrieben) -----------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dat swarte Peerd <noreply@mein-ziel-bongsiel.de>"
# Empfänger der Reservierungs-, Anmelde- und Anfragemails; mehrere mit Komma trennen
MAIL_TO_RESTAURANT=reservierung@mein-ziel-bongsiel.de

# --- Optional ----------------------------------------------------------------
# 1 = Suchmaschinen aussperren (für Vorschau/Test-Seiten)
SITE_NOINDEX=1
# 1 = lokaler Produktions-Build mit DATA_DIR im Projektordner erlauben (nur auf dem eigenen Rechner)
# ALLOW_LOCAL_DATA=1